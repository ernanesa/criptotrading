    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^26.0.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.0.9",
