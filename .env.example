# Safe template only. Copy to .env locally and never commit a populated file.
# Keep this environment bound to Binance Spot Testnet.
TRADING_ENVIRONMENT=TESTNET
BINANCE_REST_BASE_URL=https://testnet.binance.vision/api
BINANCE_WS_BASE_URL=wss://testnet.binance.vision/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Alternativa recomendada: arquivos absolutos mode 600 em diretório mode 700.
# Quando definidos, são usados somente se os valores acima estiverem vazios.
BINANCE_API_KEY_FILE=
BINANCE_API_SECRET_FILE=
BINANCE_WITHDRAWALS_ENABLED=false
BINANCE_ALLOWED_SYMBOLS=BTCUSDT

# Worker safety gates. Persistence and migrations are opt-in.
WORKER_PERSISTENCE_ENABLED=false
WORKER_APPLY_MIGRATIONS=false
WORKER_EXECUTION_MODE=PAPER
WORKER_NO_TRADE=true
# Optional one-shot local Shadow drill; requires WORKER_NO_TRADE=true.
WORKER_SHADOW_ENABLED=false
WORKER_SHADOW_REPORT_DIRECTORY=artifacts/shadow
# Optional authenticated read-only startup reconciliation; requires persistence and NO_TRADE.
WORKER_RECONCILIATION_ENABLED=false
# Optional fail-closed startup gate; requires an approved active policy in PostgreSQL.
WORKER_RISK_POLICY_REQUIRED=false
# Optional authenticated account-event ingestion; requires persistence, migrations and NO_TRADE.
WORKER_ACCOUNT_STREAM_ENABLED=false
BINANCE_USER_STREAM_WS_API_BASE_URL=wss://ws-api.testnet.binance.vision/ws-api/v3
WORKER_RECONCILIATION_ACCOUNT=exchange-wallet
WORKER_RECONCILIATION_SYMBOLS=BTCUSDT
WORKER_RECONCILIATION_MAX_SNAPSHOT_AGE_SECONDS=30
WORKER_RECONCILIATION_INTERVAL_MINUTES=15
WORKER_RECONCILIATION_REPORT_DIRECTORY=artifacts/reconciliation
WORKER_ALERT_FILE_DIRECTORY=
# Optional external alert delivery; blank disables it. If set, the host must
# appear in the explicit allowlist. Never put tokens in URL/query strings.
WORKER_ALERT_WEBHOOK_URL=
WORKER_ALERT_WEBHOOK_ALLOWED_HOSTS=
WORKER_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_OUTBOX_BATCH_SIZE=25
WORKER_OUTBOX_LEASE_SECONDS=30
# Required only when WORKER_PERSISTENCE_ENABLED=true. Keep the password out of Git.
# POSTGRES_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=cryptotrading;Username=cryptotrading;Password=local-only
# The API adds PostgreSQL to /health/ready when this variable is present.
