# Safe template only. Copy to .env locally and never commit a populated file.
# Keep this environment bound to Binance Spot Testnet.
TRADING_ENVIRONMENT=TESTNET
BINANCE_REST_BASE_URL=https://testnet.binance.vision/api
BINANCE_WS_BASE_URL=wss://testnet.binance.vision/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WITHDRAWALS_ENABLED=false
BINANCE_ALLOWED_SYMBOLS=BTCUSDT

# Worker safety gates. Persistence and migrations are opt-in.
WORKER_PERSISTENCE_ENABLED=false
WORKER_APPLY_MIGRATIONS=false
WORKER_EXECUTION_MODE=PAPER
WORKER_NO_TRADE=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_OUTBOX_BATCH_SIZE=25
WORKER_OUTBOX_LEASE_SECONDS=30
# Required only when WORKER_PERSISTENCE_ENABLED=true. Keep the password out of Git.
# POSTGRES_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=cryptotrading;Username=cryptotrading;Password=local-only
# The API adds PostgreSQL to /health/ready when this variable is present.
