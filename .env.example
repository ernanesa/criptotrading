# Safe template only. Copy to .env locally and never commit a populated file.
# Keep this environment bound to Binance Spot Testnet.
TRADING_ENVIRONMENT=TESTNET
BINANCE_REST_BASE_URL=https://testnet.binance.vision/api
BINANCE_WS_BASE_URL=wss://testnet.binance.vision/ws
# PAPER/NO_TRADE Compose does not load Binance credentials. The separate,
# opt-in Testnet override accepts only a private secret-directory mount; see
# .env.testnet.example and secrets/README.md.
# For direct host execution only (never injected by compose.yaml), protected
# absolute credential paths may be supplied after the Testnet gates are approved.
BINANCE_API_KEY_FILE=
BINANCE_API_SECRET_FILE=
BINANCE_WITHDRAWALS_ENABLED=false
BINANCE_ALLOWED_SYMBOLS=BTCUSDT

# Optional local OpenTelemetry collector. Blank means no OTLP network exporter.
# The default allowlist accepts loopback only; non-loopback hosts require an
# explicit comma-separated OTEL_EXPORTER_OTLP_ALLOWED_HOSTS value.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ALLOWED_HOSTS=

# Worker safety gates. Persistence and migrations are opt-in.
WORKER_PERSISTENCE_ENABLED=false
WORKER_APPLY_MIGRATIONS=false
WORKER_EXECUTION_MODE=PAPER
WORKER_NO_TRADE=true
# Testnet order execution remains disabled unless every gate below is explicitly changed:
# WORKER_EXECUTION_MODE=TESTNET, WORKER_NO_TRADE=false, persistence/migrations enabled,
# RiskPolicy, reconciliation and account stream enabled, plus both flags below.
# Never set these for Demo/Live (unsupported).
WORKER_TESTNET_EXECUTION_ACKNOWLEDGED=false
WORKER_TESTNET_ORDER_EXECUTION_ENABLED=false
# Optional one-shot local Shadow drill; requires WORKER_NO_TRADE=true.
WORKER_SHADOW_ENABLED=false
WORKER_SHADOW_REPORT_DIRECTORY=artifacts/shadow
# Required for Testnet execution; optional read-only startup reconciliation in PAPER.
WORKER_RECONCILIATION_ENABLED=false
# Required for Testnet execution; requires an approved active policy in PostgreSQL.
WORKER_RISK_POLICY_REQUIRED=false
# Required for Testnet execution; requires persistence, migrations and reconciliation.
WORKER_ACCOUNT_STREAM_ENABLED=false
BINANCE_USER_STREAM_WS_API_BASE_URL=wss://ws-api.testnet.binance.vision/ws-api/v3
WORKER_AUTONOMY_ENABLED=false
WORKER_AUTONOMY_SYMBOL=BTCUSDT
WORKER_AUTONOMY_INTERVAL=1m
WORKER_AUTONOMY_KLINE_LIMIT=100
WORKER_AUTONOMY_ENTRY_TARGET_NOTIONAL=100
# BUY fee reserve in basis points (25 = 0.25%); SELL does not consume quote reserve.
WORKER_AUTONOMY_FEE_RESERVE_BPS=25
WORKER_AUTONOMY_FEE_DRIFT_TOLERANCE_BPS=25
WORKER_FEE_ASSET_VALUATION_MAX_AGE_SECONDS=30
WORKER_RECONCILIATION_ACCOUNT=exchange-wallet
WORKER_RECONCILIATION_SYMBOLS=BTCUSDT
WORKER_RECONCILIATION_MAX_SNAPSHOT_AGE_SECONDS=30
WORKER_RECONCILIATION_INTERVAL_MINUTES=15
WORKER_RECONCILIATION_REPORT_DIRECTORY=artifacts/reconciliation
# Append-only lifecycle evidence; never place secrets in this file.
WORKER_RUNTIME_AUDIT_PATH=artifacts/runtime/runtime-transitions.jsonl
WORKER_ALERT_FILE_DIRECTORY=
# Optional external alert delivery; blank disables it. If set, the host must
# appear in the explicit allowlist. Never put tokens in URL/query strings.
WORKER_ALERT_WEBHOOK_URL=
WORKER_ALERT_WEBHOOK_ALLOWED_HOSTS=
WORKER_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_OUTBOX_BATCH_SIZE=25
WORKER_OUTBOX_LEASE_SECONDS=30
# Required only when WORKER_PERSISTENCE_ENABLED=true. Keep the password out of Git.
# POSTGRES_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=cryptotrading;Username=cryptotrading;Password=local-only
# The API adds PostgreSQL to /health/ready when this variable is present.
