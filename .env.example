# Copy to a local secret provider; never commit a populated .env file.
# Preferred Compose setup: point *_FILE to Docker Secret paths.
TRADING_ENVIRONMENT=TESTNET
BINANCE_REST_BASE_URL=https://testnet.binance.vision/api
BINANCE_WS_BASE_URL=wss://testnet.binance.vision/ws
BINANCE_API_KEY_FILE=/run/secrets/binance_testnet_api_key
BINANCE_API_SECRET_FILE=/run/secrets/binance_testnet_api_secret
BINANCE_WITHDRAWALS_ENABLED=false
BINANCE_ALLOWED_SYMBOLS=BTCUSDT

# Optional local-only overrides for a future host process. Do not place values
# in this tracked example; use the external secret store described in secrets/.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
