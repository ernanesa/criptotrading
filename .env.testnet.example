# Safe template for the explicitly selected Testnet Compose override only.
# Copy to the ignored .env.testnet file and set the absolute directory created
# by scripts/init-testnet-secrets.sh. The directory must be mode 700, and its
# binance_api_key and binance_api_secret files must remain mode 600.
#
# Do not put key or secret values in this file.
BINANCE_TESTNET_SECRETS_DIRECTORY=/absolute/path/to/cryptotrading/testnet
